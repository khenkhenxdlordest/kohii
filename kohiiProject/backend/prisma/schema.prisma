// Kohii Cafe — Centralized POS + Inventory
// Plan: docs/SCHEMA_PLAN.md
// Rule: every change to InventoryItem.stockQty must create a StockMovement row.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Enums ─────────────────────────

enum Role {
  ADMIN
  CLERK
  CASHIER
}

// Job of a store staff account (role CASHIER). KITCHEN only in a store with a kitchen (Alley).
enum StaffPosition {
  CASHIER
  BARISTA
  KITCHEN
}

enum StaffShift {
  AM
  PM
}

enum ProductType {
  MADE // deducts stock via recipe (latte, matcha)
  READY_MADE // resold snack; recipe = 1 pc of its own InventoryItem
}

enum ProductSize {
  REGULAR
  UPSIZE
}

// Menu group of a category. Only DRINKS can have an upsize price.
enum CategoryGroup {
  DRINKS // Coffee, Non-Coffee (soda, juice)
  RICE_MEALS
  SNACKS
}

enum InventoryItemType {
  RAW_MATERIAL
  PACKAGING
  SNACK // resold as is (Calbee, nachos)
  MEAL // ingredients for meals (hotdog, corned beef, spam, fries)
}

enum Unit {
  G
  ML
  PCS
}

enum PaymentMethod {
  CASH
  GCASH // recorded only, no online processing
}

enum DiscountType {
  NONE
  SENIOR
  PWD
}

enum OrderStatus {
  COMPLETED
  VOID_REQUESTED
  VOIDED
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum StockAuditStatus {
  DRAFT
  FINALIZED
}

enum StockMovementType {
  SALE
  STOCK_IN
  AUDIT_ADJUST
  WASTE
  VOID_RETURN
  WITHDRAW // barista takes a pack/pouch out of storage for use
}

// ──────────────────── Stores & Users ────────────────────

model Store {
  id             Int      @id @default(autoincrement())
  code           String   @unique // B1, B2 — receipt prefix
  name           String
  address        String?
  hasKitchen     Boolean  @default(false) // only Alley has a kitchen
  receiptCounter Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users          User[]
  shifts         Shift[]
  orders         Order[]
  stockMovements StockMovement[]
}

// ╔══════════════════════════════════════════════════════════════╗
// ║  AUTH  vs  PROFILE  — MAGKAHIWALAY NA TABLE                   ║
// ║                                                              ║
// ║  User        = AUTH lang: login, password, role, store,       ║
// ║                active/deactivated. Ito ang tinitingnan ng      ║
// ║                login at ng guards. Lahat ng relation (orders, ║
// ║                stock, logs) ay naka-link dito.                ║
// ║  UserProfile = PERSONAL INFO lang: pangalan, contact, email,   ║
// ║                address, photo. Walang password o role dito.   ║
// ║                                                              ║
// ║  1 User ↔ 1 UserProfile (userId @unique).                     ║
// ╚══════════════════════════════════════════════════════════════╝

// ── AUTH ── credentials + access only. NO personal info here.
model User {
  id                 Int       @id @default(autoincrement())
  username           String?   @unique // null = employee with no login (barista, kitchen)
  passwordHash       String? // null = no login. Plain text while PASSWORD_HASHING=false (dev), bcrypt for final
  role               Role? // login access: ADMIN, CLERK, CASHIER. null = no login (barista, kitchen)
  storeId            Int? // null for ADMIN (sees both stores)
  position           StaffPosition? // store staff only: cashier, barista or kitchen
  shift              StaffShift? // AM or PM, store staff only
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(true)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  store   Store?       @relation(fields: [storeId], references: [id])
  profile UserProfile?

  shifts          Shift[]
  orders          Order[]               @relation("OrderCashier")
  voidsApproved   Order[]               @relation("OrderVoidApprover")
  priceChanges    ProductPriceHistory[]
  stockIns        StockIn[]
  stockAudits     StockAudit[]          @relation("AuditCountedBy")
  auditsFinalized StockAudit[]          @relation("AuditFinalizedBy")
  wasteLogs       WasteLog[]
  stockMovements  StockMovement[]
  auditLogs       AuditLog[]

  @@index([storeId])
}

// ── PROFILE ── personal info only. NO password / role here.
model UserProfile {
  id         Int       @id @default(autoincrement())
  userId     Int       @unique
  firstName  String
  middleName String?
  lastName   String
  contactNo  String?
  email      String?   @unique
  address    String?
  birthDate  DateTime? @db.Date
  photoUrl   String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────── Catalog ───────────────────────

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  group     CategoryGroup @default(DRINKS)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

model Product {
  id           Int         @id @default(autoincrement())
  name         String      @unique
  categoryId   Int
  type         ProductType
  currentPrice Decimal     @db.Decimal(10, 2) // set by ADMIN only
  upsizePrice  Decimal?    @db.Decimal(10, 2) // null = no upsize (snacks, meals); price varies per drink
  imageUrl     String?
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  category     Category              @relation(fields: [categoryId], references: [id])
  recipeItems  RecipeItem[]
  priceHistory ProductPriceHistory[]
  orderItems   OrderItem[]

  @@index([categoryId])
}

model ProductPriceHistory {
  id          Int      @id @default(autoincrement())
  productId   Int
  size        ProductSize @default(REGULAR)
  oldPrice    Decimal? @db.Decimal(10, 2) // null on first price (or when upsize is first added)
  newPrice    Decimal? @db.Decimal(10, 2) // null when upsize is removed
  changedById Int
  reason      String?
  changedAt   DateTime @default(now())

  product   Product @relation(fields: [productId], references: [id])
  changedBy User    @relation(fields: [changedById], references: [id])

  @@index([productId, changedAt])
}

// ────────────────────── Inventory ──────────────────────
// One pooled stock shared by both stores.

model InventoryItem {
  id                Int               @id @default(autoincrement())
  name              String            @unique
  type              InventoryItemType
  unit              Unit
  stockQty          Decimal           @default(0) @db.Decimal(12, 3)
  lowStockThreshold Decimal           @default(0) @db.Decimal(12, 3)
  packSize          Decimal?          @db.Decimal(12, 3) // qty in unit per pack/pouch/can, e.g. 1000 ML per milk pouch
  packLabel         String? // e.g. pouch, can, pack, bottle
  unitCost          Decimal?          @db.Decimal(10, 2) // optional, for future profit report
  isActive          Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  recipeItems     RecipeItem[]
  stockInItems    StockInItem[]
  stockAuditItems StockAuditItem[]
  wasteLogs       WasteLog[]
  stockMovements  StockMovement[]

  @@index([type])
}

model RecipeItem {
  id              Int     @id @default(autoincrement())
  productId       Int
  inventoryItemId Int
  qtyPerUnit      Decimal @db.Decimal(12, 3)

  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@unique([productId, inventoryItemId])
}

// ──────────────────────── Sales ────────────────────────

model Shift {
  id           Int         @id @default(autoincrement())
  storeId      Int
  cashierId    Int
  status       ShiftStatus @default(OPEN)
  openingCash  Decimal     @db.Decimal(10, 2)
  expectedCash Decimal?    @db.Decimal(10, 2) // computed on close
  closingCash  Decimal?    @db.Decimal(10, 2) // counted by cashier
  openedAt     DateTime    @default(now())
  closedAt     DateTime?
  note         String?

  store   Store   @relation(fields: [storeId], references: [id])
  cashier User    @relation(fields: [cashierId], references: [id])
  orders  Order[]

  @@index([storeId, openedAt])
  @@index([cashierId, status])
}

model Order {
  id               Int           @id @default(autoincrement())
  receiptNo        String        @unique // e.g. B1-000123
  storeId          Int
  cashierId        Int
  shiftId          Int
  status           OrderStatus   @default(COMPLETED)
  paymentMethod    PaymentMethod @default(CASH)
  subtotal         Decimal       @db.Decimal(10, 2)
  discountType     DiscountType  @default(NONE)
  discountAmount   Decimal       @default(0) @db.Decimal(10, 2)
  total            Decimal       @db.Decimal(10, 2)
  amountTendered   Decimal?      @db.Decimal(10, 2)
  changeDue        Decimal?      @db.Decimal(10, 2)
  referenceNo      String? // GCash ref no.
  voidReason       String?
  voidRequestedAt  DateTime?
  voidApprovedById Int?
  voidedAt         DateTime?
  createdAt        DateTime      @default(now())

  store          Store           @relation(fields: [storeId], references: [id])
  cashier        User            @relation("OrderCashier", fields: [cashierId], references: [id])
  voidApprovedBy User?           @relation("OrderVoidApprover", fields: [voidApprovedById], references: [id])
  shift          Shift           @relation(fields: [shiftId], references: [id])
  items          OrderItem[]
  stockMovements StockMovement[]

  @@index([storeId, createdAt])
  @@index([cashierId, createdAt])
  @@index([status])
}

model OrderItem {
  id          Int     @id @default(autoincrement())
  orderId     Int
  productId   Int
  productName String // snapshot
  qty         Int
  unitPrice   Decimal @db.Decimal(10, 2) // price at time of sale
  lineTotal   Decimal @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([productId])
}

// ─────────────────── Stock operations ───────────────────

model StockIn {
  id         Int      @id @default(autoincrement())
  clerkId    Int
  supplier   String?
  note       String?
  receivedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  clerk          User            @relation(fields: [clerkId], references: [id])
  items          StockInItem[]
  stockMovements StockMovement[]

  @@index([receivedAt])
}

model StockInItem {
  id              Int      @id @default(autoincrement())
  stockInId       Int
  inventoryItemId Int
  qty             Decimal  @db.Decimal(12, 3)
  unitCost        Decimal? @db.Decimal(10, 2)

  stockIn       StockIn       @relation(fields: [stockInId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])
}

model StockAudit {
  id            Int              @id @default(autoincrement())
  countedById   Int
  finalizedById Int?
  status        StockAuditStatus @default(DRAFT)
  note          String?
  startedAt     DateTime         @default(now())
  finalizedAt   DateTime?

  countedBy      User             @relation("AuditCountedBy", fields: [countedById], references: [id])
  finalizedBy    User?            @relation("AuditFinalizedBy", fields: [finalizedById], references: [id])
  items          StockAuditItem[]
  stockMovements StockMovement[]

  @@index([status])
}

model StockAuditItem {
  id              Int     @id @default(autoincrement())
  stockAuditId    Int
  inventoryItemId Int
  systemQty       Decimal @db.Decimal(12, 3) // snapshot when counted
  countedQty      Decimal @db.Decimal(12, 3)
  variance        Decimal @db.Decimal(12, 3) // counted - system
  note            String?

  stockAudit    StockAudit    @relation(fields: [stockAuditId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@unique([stockAuditId, inventoryItemId])
}

model WasteLog {
  id              Int      @id @default(autoincrement())
  inventoryItemId Int
  qty             Decimal  @db.Decimal(12, 3)
  reason          String
  loggedById      Int
  createdAt       DateTime @default(now())

  inventoryItem  InventoryItem   @relation(fields: [inventoryItemId], references: [id])
  loggedBy       User            @relation(fields: [loggedById], references: [id])
  stockMovements StockMovement[]

  @@index([createdAt])
}

// Ledger of every stock change. qty is signed: + in, - out.
model StockMovement {
  id              Int               @id @default(autoincrement())
  inventoryItemId Int
  type            StockMovementType
  qty             Decimal           @db.Decimal(12, 3)
  balanceAfter    Decimal           @db.Decimal(12, 3)
  userId          Int
  storeId         Int? // which branch caused it (sales)
  orderId         Int?
  stockInId       Int?
  stockAuditId    Int?
  wasteLogId      Int?
  note            String?
  createdAt       DateTime          @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])
  user          User          @relation(fields: [userId], references: [id])
  store         Store?        @relation(fields: [storeId], references: [id])
  order         Order?        @relation(fields: [orderId], references: [id])
  stockIn       StockIn?      @relation(fields: [stockInId], references: [id])
  stockAudit    StockAudit?   @relation(fields: [stockAuditId], references: [id])
  wasteLog      WasteLog?     @relation(fields: [wasteLogId], references: [id])

  @@index([inventoryItemId, createdAt])
  @@index([type, createdAt])
  @@index([storeId, createdAt])
}

// ─────────────────────── Audit log ──────────────────────

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  action    String // e.g. PRICE_CHANGE, USER_DEACTIVATE, VOID_APPROVE
  entity    String // e.g. Product, User, Order
  entityId  String?
  before    Json?
  after     Json?
  ipAddress String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([createdAt])
}
